<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_blue_dark" android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        xmlns:app="http://schemas.android.com/apk/res-auto" app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back to current deliveries" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvDriverHistoryShift" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Loading shift history…" android:textAppearance="@style/Text.Section" />
            <TextView android:id="@+id/tvDriverHistoryConnection" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/tvDriverHistoryError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDriverHistoryRefresh"
                style="@style/Widget.App.SecondaryButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="Refresh history" />
            <LinearLayout android:id="@+id/driverHistoryOrders" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
