<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
    android:orientation="vertical" android:padding="32dp">
    <FrameLayout android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_circle_blue">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center"
            android:src="@drawable/ic_check" android:tint="@color/white" android:contentDescription="Success" />
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="Order placed!" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" android:textStyle="bold" />
    <TextView android:id="@+id/tvOrderId" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/terracotta" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
    <TextView android:id="@+id/tvInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTrack" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="32dp" android:text="Track order" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:text="Back to menu" android:textStyle="bold" />
</LinearLayout>
