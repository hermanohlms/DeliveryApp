<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/driverScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="24dp" android:background="@color/gunmetal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pete’s Pizza · Delivery team"
                android:textColor="@color/terracotta" android:textStyle="bold" android:textSize="20sp" />
            <TextView android:id="@+id/tvDriverName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="My shift" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/white" />
            <TextView android:id="@+id/tvDriverBranch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvDriverShift" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Connecting to your shift…" android:textAppearance="@style/Text.Section" />
            <TextView android:id="@+id/tvDriverSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvDriverConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/tvDriverError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDriverRetry" style="@style/Widget.App.SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Refresh shift" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDriverClaim" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="Claim next delivery" android:enabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="Current deliveries" android:textAppearance="@style/Text.Section" />
            <LinearLayout android:id="@+id/driverActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDriverHistory" style="@style/Widget.App.SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:minHeight="56dp" android:text="View shift history (0)" android:enabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDriverEnd" style="@style/Widget.App.SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:minHeight="56dp" android:text="End shift &amp; sign out" android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
