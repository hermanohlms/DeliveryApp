<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeliveryApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/terracotta_soft</item>
        <item name="colorOnPrimaryContainer">@color/gunmetal</item>
        <item name="colorSecondary">@color/steel_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/steel_blue_soft</item>
        <item name="colorOnSecondaryContainer">@color/gunmetal</item>
        <item name="colorTertiary">@color/gunmetal</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gunmetal</item>
        <item name="colorSurfaceVariant">@color/paper_variant</item>
        <item name="colorOnSurfaceVariant">@color/gunmetal</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/gunmetal</item>
        <item name="android:statusBarColor">@color/gunmetal</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/gunmetal</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
