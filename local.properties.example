# Add these two lines to local.properties (Android Studio creates that file with sdk.dir).
# Never commit local.properties.

# Where the Spring Boot backend lives.
#   Android emulator  -> http://10.0.2.2:8080/
#   Real phone on Wi-Fi -> http://<your-computer-ip>:8080/
#   Production -> https://your-domain/
API_BASE_URL=http://10.0.2.2:8080/

# Use a separate Android-restricted key, not the backend/website referrer-restricted key.
# Restrict it to package com.example.deliveryapp and this build's signing certificate SHA-1.
# Limit API access to Places API (New) and Maps SDK for Android.
# Add release signing certificate SHA-1 separately before distributing a release build.
MAPS_API_KEY=

# Optional. "false" hides the PayFast option at checkout (cash only). Default: true.
# PayFast merchant id / key / passphrase are NOT app settings - they live on the backend only.
#PAYFAST_ENABLED=true
